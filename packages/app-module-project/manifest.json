{
  "id": "project",
  "expose": {
    "slots": {
      "project-panels": {
        "accepts": ["Section", "Collapsible", "Badge", "ButtonLink"]
      },
      "project-links": {
        "accepts": ["ButtonLink", "IconButton", "Badge"]
      }
    }
  },
  "extensionPoints": [
    {
      "kind": "page",
      "slot": "nav",
      "label": "Projects",
      "path": "/",
      "view": { "type": "path", "value": "./src/dsl-views/projects-page.yaml" }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Tree",
      "path": "/tree",
      "view": { "type": "path", "value": "./src/dsl-views/tree-page.yaml" }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Trash",
      "path": "/deleted",
      "view": { "type": "path", "value": "./src/dsl-views/deleted-page.yaml" }
    },
    {
      "kind": "page",
      "slot": "route",
      "label": "Project",
      "path": "/p/:project",
      "view": { "type": "path", "value": "./src/dsl-views/project-page.yaml" }
    }
  ]
}
