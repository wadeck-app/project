{
  "name": "@wadeck-app/project-cli",
  "version": "0.0.1",
  "description": "The project command: register, inspect and resolve the projects shared by the task, flow and queue CLIs",
  "type": "module",
  "bin": {
    "project": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wadeck-app/project.git",
    "directory": "packages/project-cli"
  },
  "publishConfig": {
    "@wadeck-app:registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "test": "vitest run --bail=1",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wadeck-app/project-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
