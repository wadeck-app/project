    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wadeck-app/project-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
